BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "CLK"        SITE "G2" ;
IOBUF  PORT "CLK"        PULLMODE=NONE IO_TYPE=LVCMOS33 ;
FREQUENCY PORT "CLK"     25 MHZ;

SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE;

# FTDI UART
LOCATE COMP "ftdi_rxd"   SITE "L4" ;
IOBUF  PORT "ftdi_rxd"   PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
LOCATE COMP "ftdi_txd"   SITE "M1" ;
IOBUF  PORT "ftdi_txd"   PULLMODE=UP IO_TYPE=LVCMOS33 ;

# Debug: Flute's RISC-V Debug Module is reachable over the FTDI UART
# via the Uart_DMI_Bridge (magic "\xDBSDM\x01\x02\x03\x04", then
# fixed-frame DMI; see src/Uart_DMI_Bridge.bsv and scripts/dmi.py).

# RISC-V debug: lx45 moved the DTM onto the FPGA's configuration JTAG port (JTAGG in src/Top.v,
# the FT231X on US1), so header J1's A10/A11/B11/C11 are free.

# Buttons

# Buttons
LOCATE COMP "BTN1"       SITE "R1" ;
IOBUF  PORT "BTN1"       PULLMODE=DOWN IO_TYPE=LVCMOS33 ;

# LEDs
LOCATE COMP "led[0]"     SITE "B2" ;
LOCATE COMP "led[1]"     SITE "C2" ;
LOCATE COMP "led[2]"     SITE "C1" ;
LOCATE COMP "led[3]"     SITE "D2" ;
LOCATE COMP "led[4]"     SITE "D1" ;
LOCATE COMP "led[5]"     SITE "E2" ;
LOCATE COMP "led[6]"     SITE "E1" ;
LOCATE COMP "led[7]"     SITE "H3" ;
IOBUF  PORT "led[*]"     PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4 ;

# ESP32: hold in reset so it cannot interfere with the FTDI UART
LOCATE COMP "wifi_en"    SITE "F1" ;
IOBUF  PORT "wifi_en"    PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;

# microSD slot in SPI mode (pins shared with the ESP32, which wifi_en holds in reset).
# sd_d[1] (H1) and sd_d[2] (K1) are not used in SPI mode and are left out of the design.
LOCATE COMP "sd_clk"     SITE "H2" ;
LOCATE COMP "sd_cmd"     SITE "J1" ;
LOCATE COMP "sd_d0"      SITE "J3" ;
LOCATE COMP "sd_d3"      SITE "K2" ;
IOBUF  PORT "sd_clk"     PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF  PORT "sd_cmd"     PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF  PORT "sd_d0"      PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;  # also drives the ESP32 GPIO2 strap
IOBUF  PORT "sd_d3"      PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;

# Configuration flash after configuration (MASTER_SPI_PORT=DISABLE above frees these pins; the
# clock is CCLK, U3, driven through the USRMCLK primitive in src/Top.v).  JTAG flash writes
# (openFPGALoader -f) erase the SRAM first and are unaffected.
LOCATE COMP "flash_csn"   SITE "R2" ;
LOCATE COMP "flash_mosi"  SITE "W2" ;
LOCATE COMP "flash_miso"  SITE "V2" ;
LOCATE COMP "flash_wpn"   SITE "Y2" ;
LOCATE COMP "flash_holdn" SITE "W1" ;
IOBUF  PORT "flash_csn"   PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF  PORT "flash_mosi"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF  PORT "flash_miso"  PULLMODE=UP IO_TYPE=LVCMOS33 ;
IOBUF  PORT "flash_wpn"   PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF  PORT "flash_holdn" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;

# GPDI (HDMI connector) as DVI: three TMDS data pairs and the clock pair.  LVCMOS33D drives
# each gpdi_dp pin and its paired _dn pin (B16, C14, A13, B18) as the complement.
LOCATE COMP "gpdi_dp[0]" SITE "A16" ;   # blue
LOCATE COMP "gpdi_dp[1]" SITE "A14" ;   # green
LOCATE COMP "gpdi_dp[2]" SITE "A12" ;   # red
LOCATE COMP "gpdi_dp[3]" SITE "A17" ;   # clock
IOBUF  PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33D DRIVE=4 ;
IOBUF  PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33D DRIVE=4 ;
IOBUF  PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33D DRIVE=4 ;
IOBUF  PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33D DRIVE=4 ;

# SDR SDRAM (Winbond W9825G6KH-6, 32 MB, 16-bit)
LOCATE COMP "sdram_clk"  SITE "F19" ;
LOCATE COMP "sdram_cke"  SITE "F20" ;
LOCATE COMP "sdram_cs_n" SITE "P20" ;
LOCATE COMP "sdram_ras_n" SITE "R20" ;
LOCATE COMP "sdram_cas_n" SITE "T19" ;
LOCATE COMP "sdram_we_n" SITE "T20" ;
LOCATE COMP "sdram_ba[0]" SITE "P19" ;
LOCATE COMP "sdram_ba[1]" SITE "N20" ;
LOCATE COMP "sdram_a[0]" SITE "M20" ;
LOCATE COMP "sdram_a[1]" SITE "M19" ;
LOCATE COMP "sdram_a[2]" SITE "L20" ;
LOCATE COMP "sdram_a[3]" SITE "L19" ;
LOCATE COMP "sdram_a[4]" SITE "K20" ;
LOCATE COMP "sdram_a[5]" SITE "K19" ;
LOCATE COMP "sdram_a[6]" SITE "K18" ;
LOCATE COMP "sdram_a[7]" SITE "J20" ;
LOCATE COMP "sdram_a[8]" SITE "J19" ;
LOCATE COMP "sdram_a[9]" SITE "H20" ;
LOCATE COMP "sdram_a[10]" SITE "N19" ;
LOCATE COMP "sdram_a[11]" SITE "G20" ;
LOCATE COMP "sdram_a[12]" SITE "G19" ;
LOCATE COMP "sdram_dq[0]"  SITE "J16" ;
LOCATE COMP "sdram_dq[1]"  SITE "L18" ;
LOCATE COMP "sdram_dq[2]"  SITE "M18" ;
LOCATE COMP "sdram_dq[3]"  SITE "N18" ;
LOCATE COMP "sdram_dq[4]"  SITE "P18" ;
LOCATE COMP "sdram_dq[5]"  SITE "T18" ;
LOCATE COMP "sdram_dq[6]"  SITE "T17" ;
LOCATE COMP "sdram_dq[7]"  SITE "U20" ;
LOCATE COMP "sdram_dq[8]"  SITE "E19" ;
LOCATE COMP "sdram_dq[9]"  SITE "D20" ;
LOCATE COMP "sdram_dq[10]" SITE "D19" ;
LOCATE COMP "sdram_dq[11]" SITE "C20" ;
LOCATE COMP "sdram_dq[12]" SITE "E18" ;
LOCATE COMP "sdram_dq[13]" SITE "F18" ;
LOCATE COMP "sdram_dq[14]" SITE "J18" ;
LOCATE COMP "sdram_dq[15]" SITE "J17" ;
LOCATE COMP "sdram_dqm[0]" SITE "U19" ;
LOCATE COMP "sdram_dqm[1]" SITE "E20" ;

IOBUF PORT "sdram_clk"  IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_cke"  IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_cs_n" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_ras_n" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_cas_n" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_we_n" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_ba[*]" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_a[*]" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_dq[*]" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "sdram_dqm[*]" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;

# Board_IO: buttons, DIP switches, the I2C bus shared by the RTC and HDMI DDC.  Sites and pulls
# from the board's official constraints (emard/ulx3s doc/constraints/ulx3s_v20.lpf).
LOCATE COMP "btn_pwr_n"    SITE "D6" ;
LOCATE COMP "btn_rest[0]"  SITE "T1" ;
LOCATE COMP "btn_rest[1]"  SITE "R18" ;
LOCATE COMP "btn_rest[2]"  SITE "V1" ;
LOCATE COMP "btn_rest[3]"  SITE "U1" ;
LOCATE COMP "btn_rest[4]"  SITE "H16" ;
LOCATE COMP "sw[0]"        SITE "E8" ;
LOCATE COMP "sw[1]"        SITE "D8" ;
LOCATE COMP "sw[2]"        SITE "D7" ;
LOCATE COMP "sw[3]"        SITE "E7" ;
LOCATE COMP "gpdi_sda"     SITE "B19" ;
LOCATE COMP "gpdi_scl"     SITE "E12" ;
IOBUF  PORT "btn_pwr_n"    PULLMODE=UP   IO_TYPE=LVCMOS33 ;
IOBUF  PORT "btn_rest[0]"  PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "btn_rest[1]"  PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "btn_rest[2]"  PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "btn_rest[3]"  PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "btn_rest[4]"  PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "sw[0]"        PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "sw[1]"        PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "sw[2]"        PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "sw[3]"        PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF  PORT "gpdi_sda"     PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF  PORT "gpdi_scl"     PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;

# Audio jack DACs (src/Audio.v): official ulx3s_v20.lpf
LOCATE COMP "audio_l[0]"   SITE "E4" ;
IOBUF  PORT "audio_l[0]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;
LOCATE COMP "audio_l[1]"   SITE "D3" ;
IOBUF  PORT "audio_l[1]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;
LOCATE COMP "audio_l[2]"   SITE "C3" ;
IOBUF  PORT "audio_l[2]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;
LOCATE COMP "audio_l[3]"   SITE "B3" ;
IOBUF  PORT "audio_l[3]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;
LOCATE COMP "audio_r[0]"   SITE "A3" ;
IOBUF  PORT "audio_r[0]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;
LOCATE COMP "audio_r[1]"   SITE "B5" ;
IOBUF  PORT "audio_r[1]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;
LOCATE COMP "audio_r[2]"   SITE "D5" ;
IOBUF  PORT "audio_r[2]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;
LOCATE COMP "audio_r[3]"   SITE "C5" ;
IOBUF  PORT "audio_r[3]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=16 ;

# On-board ADC (MAX11125) on spi2: official ulx3s_v20.lpf.  Its inputs share gp/gn[14..17]:
# keep those out of this file, so the FPGA pins stay high-impedance with no pull-up.
LOCATE COMP "adc_csn"     SITE "R17" ;
IOBUF  PORT "adc_csn"     PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
LOCATE COMP "adc_mosi"     SITE "R16" ;
IOBUF  PORT "adc_mosi"     IO_TYPE=LVCMOS33 DRIVE=4 ;
LOCATE COMP "adc_miso"     SITE "U16" ;
IOBUF  PORT "adc_miso"     IO_TYPE=LVCMOS33 DRIVE=4 ;
LOCATE COMP "adc_sclk"     SITE "P17" ;
IOBUF  PORT "adc_sclk"     IO_TYPE=LVCMOS33 DRIVE=4 ;

# ESP32 UART0 (uart1) and GPIO0: official ulx3s_v20.lpf.  GPIO0 is driven low (src/Top.v).
LOCATE COMP "wifi_rxd"     SITE "K3" ;
IOBUF  PORT "wifi_rxd"     PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;
LOCATE COMP "wifi_txd"     SITE "K4" ;
# pulled down (lx45): an ESP32 that runs drives its TX high when idle, so gpio1 0x0C bit 1 reading 0
# with the ESP32 released means nothing is driving the line (no module, or it is not running)
IOBUF  PORT "wifi_txd"     PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4 ;
LOCATE COMP "wifi_gpio0"     SITE "L2" ;
IOBUF  PORT "wifi_gpio0"     PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;

# Power and reconfiguration (official ulx3s_v20.lpf).  SHUTDOWN = 1 turns the board off; USER_PROGRAMN is
# PROGRAMN, released (pulled up) unless software asks for a reconfiguration from flash.
LOCATE COMP "shutdown"      SITE "G16" ;
IOBUF  PORT "shutdown"      PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4 ;
LOCATE COMP "user_programn" SITE "M4" ;
IOBUF  PORT "user_programn" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4 ;

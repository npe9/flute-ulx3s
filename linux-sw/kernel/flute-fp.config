# Applied on top of tinyconfig + 32-bit.config (see build.sh)
CONFIG_ARCH_RV32I=y
CONFIG_32BIT=y
CONFIG_NONPORTABLE=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_OF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/work/init-fp/initramfs.list"
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_STACKTRACE=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_MODULES=n
CONFIG_EFI=n
CONFIG_CMDLINE=""
# Boot-time trims (initcall_debug, Oct 2026): legacy BSD ptys cost 14.3 s of simulated boot,
# the VT console 2.2 s (chr_dev_init -> tty_init), the unaligned-access speed probe 1 s.
# Flute traps misaligned accesses to OpenSBI, so "slow" is the accurate answer.
CONFIG_LEGACY_PTYS=n
CONFIG_VT=n
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
# microSD over SPI (src/AXI4_SPI.bsv: SiFive SPI registers; dts-fp spi@c0004000 + mmc-spi-slot)
CONFIG_BLOCK=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SIFIVE=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_SPI=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# DVI framebuffer (dts-fp framebuffer@c1000000, simple-framebuffer) with a text console on
# tty0; the 8x8 font gives 40x30.  /dev/mem lets /init set the scan-out mode.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
# lx44 board devices: I2C (OpenCores registers) + the MCP7940N RTC, the system time from it at boot;
# buttons as keys (gpio-mmio + gpio-keys-polled); power-off through the gpio1 POWER register; audio.
CONFIG_I2C=y
CONFIG_I2C_OCORES=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_DS1307=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_GENERIC_PLATFORM=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_FLUTE_AUDIO=y
# on-board ADC (kernel/drivers/max1112x.c)
CONFIG_IIO=y
CONFIG_MAX1112X=y

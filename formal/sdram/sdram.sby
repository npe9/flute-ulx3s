[options]
bmc: mode bmc
bmc: depth 140
pg: mode prove
gk: mode prove
prove_refresh: depth 6
prove_decode: depth 12
prove_credit: depth 12
prove_handoff: mode bmc
prove_handoff: depth 200
bmc_deep: mode bmc
bmc_deep: depth 400
prove_kctl: mode prove
prove_kctl: depth 50
prove_k: mode prove
prove_k: depth 12
cover: mode cover
cover: depth 140

[engines]
bmc: smtbmc boolector
pg: abc pdr
gk: smtbmc boolector
bmc_deep: abc bmc3
prove_handoff: abc bmc3
prove_kctl: smtbmc boolector
prove_k: smtbmc boolector
cover: smtbmc boolector

[script]
read_verilog -D BSV_NO_INITIAL_BLOCKS SizedFIFO.v
read_verilog -D BSV_NO_INITIAL_BLOCKS mkSdramFormal.v
full: read_verilog -formal -sv sdram_fv.sv
prove_init: read_verilog -formal -sv -D NO_DATA -D ONLY_ANY -D ONLY_INIT sdram_fv.sv
prove_timing: read_verilog -formal -sv -D NO_DATA -D ONLY_ANY -D ONLY_TIMING sdram_fv.sv
prove_refresh: read_verilog -formal -sv -D NO_DATA -D ONLY_ANY -D ONLY_REFRESH sdram_fv.sv
prove_handoff: read_verilog -formal -sv -D NO_DATA -D ONLY_ANY -D ONLY_HANDOFF sdram_fv.sv
prove_decode: read_verilog -formal -sv -D NO_DATA -D ONLY_ANY -D ONLY_DECODE sdram_fv.sv
prove_credit: read_verilog -formal -sv -D NO_DATA -D ONLY_ANY -D ONLY_CREDIT sdram_fv.sv
bmc_deep: read_verilog -formal -sv -D NO_DATA sdram_fv.sv
prove_kctl: read_verilog -formal -sv -D NO_DATA sdram_fv.sv
prove_k: read_verilog -formal -sv -D DATA_ONLY sdram_fv.sv
prep -top sdram_fv


[tasks]
bmc plain
bmc_rst rst
prove plain
prove_rst rst
cover

[options]
bmc: mode bmc
bmc: depth 20
bmc_rst: mode bmc
bmc_rst: depth 20
prove: mode prove
prove_rst: mode prove
cover: mode cover
cover: depth 30

[engines]
prove: abc pdr
prove_rst: abc pdr
bmc: smtbmc boolector
bmc_rst: smtbmc boolector
cover: smtbmc boolector

[script]
read_verilog -D BSV_NO_INITIAL_BLOCKS FIFO2.v FIFO1.v
~cover: read_verilog -D BSV_NO_INITIAL_BLOCKS mkAXI4_RegBus.v
cover: read_verilog -D BSV_NO_INITIAL_BLOCKS short/mkAXI4_RegBus.v
rst: read_verilog -formal -sv -D WITH_EXT_RESET regbus_fv.sv
cover: read_verilog -formal -sv -D SHORT_WDOG regbus_fv.sv
plain: read_verilog -formal -sv regbus_fv.sv
prep -top regbus_fv

[files]
/Users/npe/src/bsc/inst/lib/Verilog/FIFO2.v
/Users/npe/src/bsc/inst/lib/Verilog/FIFO1.v
../../build/formal-regbus/v/mkAXI4_RegBus.v
short/mkAXI4_RegBus.v ../../build/formal-regbus-short/v/mkAXI4_RegBus.v
regbus_fv.sv

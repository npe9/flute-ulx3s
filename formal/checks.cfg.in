# riscv-formal configuration for Flute (flute-ulx3s).  Generated into checks.cfg by
# formal/run.sh (which fills in @LIBS@ with the BSC library Verilog files).
# Depths: the core needs ~N cycles after reset (cache/regfile/BTB reset loops,
# first fetch through the AXI slave) before the first retirement; see README.md.
[options]
isa @ISA@
nret 1
solver boolector

[depth]
insn        @INSN_DEPTH@
reg         1 @REG_DEPTH@
pc_fwd      1 @PC_DEPTH@
pc_bwd      1 @PC_DEPTH@
unique      1 @LIVE_START@ @REG_DEPTH@
causal      1 @REG_DEPTH@
liveness    1 @LIVE_START@ @LIVE_DEPTH@
cover       1 @COVER_DEPTH@

[defines]
`define RISCV_FORMAL_ALIGNED_MEM
`define RISCV_FORMAL_MEM_FAULT
`define RISCV_FORMAL_UMODE
`define RISCV_FORMAL_SMODE
`define FLUTE_AXI_STALL 0
`define BSV_NO_INITIAL_BLOCKS

[cover]
always @* if (!reset) cover (channel[0].cnt_insns == 1);
always @* if (!reset) cover (channel[0].cnt_insns == 2);
always @* if (!reset) cover (channel[0].cnt_insns == 4);
always @* if (!reset) cover (channel[0].cnt_trap_insns == 1);

[verilog-files]
@basedir@/cores/@core@/wrapper.sv
@basedir@/cores/@core@/axi_formal_slave.sv
@basedir@/cores/@core@/verilog_cpu.v
@LIBS@

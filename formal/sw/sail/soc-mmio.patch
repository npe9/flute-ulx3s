diff --git a/model/riscv_platform.sail b/model/riscv_platform.sail
index 19e3d30..9a92b65 100644
--- a/model/riscv_platform.sail
+++ b/model/riscv_platform.sail
@@ -384,16 +384,23 @@ function htif_tick() = {
 }
 
 /* Top-level MMIO dispatch */
+/* SoC device windows (ulx3s game2d: formal/sw/sail/socdev.c), word accesses only; the C side
+   checks the address is a real register and logs every write */
+val soc_read  = {c: "soc_read"}  : xlenbits -> bits(32)
+val soc_write = {c: "soc_write"} : (xlenbits, bits(32)) -> unit
+function within_soc forall 'n, 0 < 'n <= max_mem_access . (addr : xlenbits, width : int('n)) -> bool =
+  'n == 4 & addr >=_u 0xC0000000 & addr <_u 0xC2000000
+
 $ifndef RVFI_DII
 function within_mmio_readable forall 'n, 0 < 'n <= max_mem_access . (addr : xlenbits, width : int('n)) -> bool =
-  within_clint(addr, width) | (within_htif_readable(addr, width) & 1 <= 'n)
+  within_clint(addr, width) | (within_htif_readable(addr, width) & 1 <= 'n) | within_soc(addr, width)
 $else
 function within_mmio_readable forall 'n, 0 < 'n <= max_mem_access . (addr : xlenbits, width : int('n)) -> bool = false
 $endif
 
 $ifndef RVFI_DII
 function within_mmio_writable forall 'n, 0 < 'n <= max_mem_access . (addr : xlenbits, width : int('n)) -> bool =
-  within_clint(addr, width) | (within_htif_writable(addr, width) & 'n <= 8)
+  within_clint(addr, width) | (within_htif_writable(addr, width) & 'n <= 8) | within_soc(addr, width)
 $else
 function within_mmio_writable forall 'n, 0 < 'n <= max_mem_access . (addr : xlenbits, width : int('n)) -> bool = false
 $endif
@@ -403,6 +410,8 @@ function mmio_read forall 'n, 0 < 'n <= max_mem_access . (t : AccessType(ext_acc
   then clint_load(t, paddr, width)
   else if within_htif_readable(paddr, width) & (1 <= 'n)
   then htif_load(t, paddr, width)
+  else if within_soc(paddr, width) & ('n == 4) & t == Read(Data)
+  then MemValue(sail_zero_extend(soc_read(paddr), 32))
   else match t {
     Execute()  => MemException(E_Fetch_Access_Fault()),
     Read(Data) => MemException(E_Load_Access_Fault()),
@@ -414,6 +423,8 @@ function mmio_write forall 'n, 0 <'n <= max_mem_access . (paddr : xlenbits, widt
   then clint_store(paddr, width, data)
   else if within_htif_writable(paddr, width) & 'n <= 8
   then htif_store(paddr, width, data)
+  else if within_soc(paddr, width) & ('n == 4)
+  then { soc_write(paddr, data[31..0]); MemValue(true) }
   else MemException(E_SAMO_Access_Fault())
 
 /* Platform initialization and ticking. */
diff --git a/model/riscv_sys_control.sail b/model/riscv_sys_control.sail

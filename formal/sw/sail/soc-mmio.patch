--- a/model/riscv_sys_control.sail
+++ b/model/riscv_sys_control.sail
@@ -315,9 +315,13 @@ $endif
 
 /* handle exceptional ctl flow by updating nextPC and operating privilege */
 
+/* every trap is reported to the SoC model (ulx3s formal/sw/sail/socdev.c) */
+val soc_trap = {c: "soc_trap"} : (bool, exc_code, xlenbits) -> unit
+
 function trap_handler(del_priv : Privilege, intr : bool, c : exc_code, pc : xlenbits, info : option(xlenbits), ext : option(ext_exception))
                      -> xlenbits = {
   rvfi_trap();
+  soc_trap(intr, c, pc);
   if   get_config_print_platform()
   then print_platform("handling " ^ (if intr then "int#" else "exc#")
                       ^ BitStr(c) ^ " at priv " ^ to_str(del_priv)

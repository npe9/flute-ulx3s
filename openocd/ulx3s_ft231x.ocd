# ULX3S on-board FT231X bit-banged JTAG interface.
# The FT231X modem-control pins are wired to the FPGA JTAG TAP:
#   TCK  <- nDSR
#   TMS  <- nDCD
#   TDI  <- nRI
#   TDO  -> nCTS
interface ft232r
ft232r_vid_pid 0x0403 0x6015
ft232r_tck_num DSR
ft232r_tms_num DCD
ft232r_tdi_num RI
ft232r_tdo_num CTS
ft232r_restore_serial 0x15
adapter_khz 1000
